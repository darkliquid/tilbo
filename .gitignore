# Ignore everything by default
*

# Allow directories to be traversed
!*/

# Source code and configuration extensions
!*.go
!*.mod
!*.sum
!*.yaml
!*.yml
!*.toml
!*.md
!*.sql
!*.proto
!*.json
!*.mdx
!*.txt
!*.wasm
!*.qml
!*.js
!*.ts
!qmldir
!*.mjs
!*.sh

# Specific project files
!.gitignore
!.gitattributes
!LICENSE
!Makefile

# SystemD, XDG, etc files
!packaging/*

# Explicitly exclude build output and caches
/tilbo-cli
/tilbo-daemon
memory/
.claude/
.vscode/
node_modules/
